{
  "name": "kc-aluminium-catalogue",
  "version": "1.0.0",
  "private": true,
  "description": "KC Aluminium responsive product catalogue prototype",
  "scripts": {
    "serve": "node scripts/serve.js",
    "playwright:install": "playwright install --with-deps chromium",
    "playwright:verify": "node scripts/verify-playwright.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "screenshot": "playwright test tests/screenshot.spec.js --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0"
  }
}
